# Build stage
FROM gradle:8.12.0-jdk21 AS builder
WORKDIR /app

# Copy dependency definitions first
COPY build.gradle settings.gradle ./

# Download dependencies only (this layer can be cached)
RUN gradle dependencies

# Copy source code
COPY src ./src

# Build the application
RUN gradle build -x test

# Runtime stage
FROM openjdk:21-slim
WORKDIR /app

# app log 디렉토리 생성 및 권한 추가
RUN mkdir -p /app/logs && chown -R www-data:www-data /app/logs

# Add non-root user
USER www-data

# Set ownership and switch to non-root user
COPY --from=builder --chown=www-data:www-data /app/build/libs/streaming-0.0.1-SNAPSHOT.jar app.jar

# HLS 및 PID 경로 생성 및 권한 설정
RUN mkdir -p /tmp/hls /tmp/hls_audio /tmp/pids && \
    chown -R www-data:www-data /tmp/hls /tmp/hls_audio /tmp/pids

# 🛠️ root 권한으로 전환
USER root

# curl, ffmpeg 설치
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# 🛠️ 다시 비-루트 사용자로 전환
USER www-data

# Configure JVM options
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

EXPOSE 8080
CMD ["java", "-jar", "app.jar"]